# =============================================================================
# School ERP — Environment Configuration
# Auto-generated because no .env file existed. Copy of this file's contents
# is also in .env.example (safe to commit; this one should NOT be committed).
# =============================================================================

APP_NAME="School ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/school-erp/public
APP_TIMEZONE=Asia/Kathmandu
APP_KEY=

# -----------------------------------------------------------------------
# Database (XAMPP defaults — adjust if yours differ)
# -----------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_erp
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------
# Mail / SMTP
# -----------------------------------------------------------------------
# MAIL_MAILER: smtp | mail | log
#   smtp -> real delivery via PHPMailer (requires MAIL_HOST/USERNAME/PASSWORD
#           below AND "composer install" to pull in phpmailer/phpmailer)
#   mail -> PHP's native mail() function (needs a configured local MTA)
#   log  -> does not send anything; writes every outgoing email to
#           storage/logs/mail.log so you can test the app without SMTP.
#           The UI will always show an honest "not sent" message in this mode.
#
# Left blank on purpose: password reset / verification emails will NOT be
# delivered until you fill these in. Visit Settings > Mail Setup in the app
# for step-by-step provider instructions (Gmail, Outlook, custom SMTP, etc).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@schoolerp.local
MAIL_FROM_NAME="School ERP"

# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------
SESSION_NAME=school_erp_session
SESSION_LIFETIME=7200
REMEMBER_ME_DAYS=30

# -----------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880

# -----------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------
FEATURE_EMAIL_VERIFICATION=true
FEATURE_SECURITY_QUESTIONS=false

# -----------------------------------------------------------------------
# OTP (password reset via code)
# -----------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------
# SMS (password reset via SMS) — driver: log | twilio | vonage
# -----------------------------------------------------------------------
SMS_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# -----------------------------------------------------------------------
# Institute details (used on printed fee bills etc.)
# -----------------------------------------------------------------------
INSTITUTE_COUNCIL=
INSTITUTE_NAME="School ERP"
INSTITUTE_ADDRESS=
INSTITUTE_PHONE=
