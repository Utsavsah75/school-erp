{
    "name": "schoolerp/school-erp",
    "description": "School ERP System - PHP 8 / MySQL / MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true
    }
}
